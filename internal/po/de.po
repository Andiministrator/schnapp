msgid "the settings file is larger than 64 KiB"
msgstr "die Einstellungsdatei ist größer als 64 KiB"

msgid "the settings file is not a regular file"
msgstr "die Einstellungsdatei ist keine gewöhnliche Datei"

msgid "the settings file is not valid UTF-8"
msgstr "die Einstellungsdatei ist kein gültiges UTF-8"

