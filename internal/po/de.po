# cmd/schnapp: Kommandozeile
msgid "Unknown option: %s"
msgstr "Unbekannte Option: %s"

msgid "Unexpected argument: %s"
msgstr "Unerwartetes Argument: %s"

msgid "Option %s takes no value."
msgstr "Die Option %s nimmt keinen Wert."

msgid "Option --screen needs a monitor name after the equals sign."
msgstr "Die Option --screen braucht nach dem Gleichheitszeichen einen Monitornamen."

msgid "Options %s and %s cannot be combined."
msgstr "Die Optionen %s und %s lassen sich nicht kombinieren."

msgid "Try --help for the available options."
msgstr "Die verfügbaren Optionen zeigt --help."

msgid "Schnapp %s"
msgstr "Schnapp %s"

msgid "Usage: schnapp [option] [--json] [--output=FILE] | schnapp [--ignore-limit] [--export=TARGET [--json]] FILE"
msgstr "Aufruf: schnapp [Option] [--json] [--output=DATEI] | schnapp [--ignore-limit] [--export=ZIEL [--json]] DATEI"

msgid "Take a screenshot. Without an option, you select an area (--region)."
msgstr "Nimmt einen Screenshot auf. Ohne Option wird ein Bereich gewählt (--region)."

msgid "Select an area"
msgstr "Bereich auswählen"

msgid "Capture a monitor, as set in the settings (default: pick by click)"
msgstr "Nimmt einen Monitor auf, laut Einstellung (Voreinstellung: per Klick wählen)"

msgid "List the monitors"
msgstr "Monitore auflisten"

msgid "Capture the monitor NAME"
msgstr "Monitor NAME aufnehmen"

msgid "Select a window"
msgstr "Fenster auswählen"

msgid "Repeat the last area"
msgstr "Letzten Bereich wiederholen"

msgid "Show the version"
msgstr "Version anzeigen"

msgid "Show this help"
msgstr "Diese Hilfe anzeigen"

msgid "Could not query the monitors: %v"
msgstr "Die Monitore ließen sich nicht abfragen: %v"

msgid "No monitors found."
msgstr "Keine Monitore gefunden."

msgid "%d monitor found:"
msgid_plural "%d monitors found:"
msgstr[0] "%d Monitor gefunden:"
msgstr[1] "%d Monitore gefunden:"

msgid "  %s: %d × %d pixels"
msgstr "  %s: %d × %d Pixel"

# aufnahme: Aufnahmeschicht
msgid "Schnapp is not registered as a screenshot program. Install its desktop file and try again."
msgstr "Schnapp ist nicht als Aufnahmeprogramm eingetragen. Die Desktop-Datei von Schnapp muss installiert sein."

msgid "The capture was cancelled."
msgstr "Die Aufnahme wurde abgebrochen."

msgid "KWin offers no screenshot interface. Schnapp needs KDE Plasma on Wayland."
msgstr "KWin bietet keine Aufnahmeschnittstelle an. Schnapp braucht KDE Plasma unter Wayland."

msgid "This KWin version cannot capture all screens at once. Use a single screen instead."
msgstr "Diese KWin-Version kann nicht alle Bildschirme auf einmal aufnehmen. Wähle stattdessen einen einzelnen Bildschirm."

# einstellungen: Einstellungsdatei (settings.ini)
msgid "Cannot locate the settings file (%v); using the defaults."
msgstr "Die Einstellungsdatei ist nicht auffindbar (%v); es gelten die Voreinstellungen."

msgid "%s: cannot read the settings file (%v); using the defaults."
msgstr "%s: Die Einstellungsdatei ist nicht lesbar (%v); es gelten die Voreinstellungen."

msgid "Broken section header; its settings up to the next section are ignored."
msgstr "Abschnittskopf ist unvollständig; seine Einstellungen bis zum nächsten Abschnitt werden ignoriert."

msgid "Unknown section [%s]; its keys are ignored."
msgstr "Unbekannter Abschnitt [%s]; seine Schlüssel werden ignoriert."

msgid "Line is neither a section, a comment nor \"key = value\"; ignored."
msgstr "Die Zeile ist weder Abschnitt noch Kommentar noch „Schlüssel = Wert“; ignoriert."

msgid "Setting %q is outside of any section; ignored."
msgstr "Einstellung %q steht außerhalb eines Abschnitts; ignoriert."

msgid "Unknown key %q in section [%s]; ignored."
msgstr "Unbekannter Schlüssel %q im Abschnitt [%s]; ignoriert."

msgid "Invalid value %q for key %q in section [%s]; ignored."
msgstr "Ungültiger Wert %q für den Schlüssel %q im Abschnitt [%s]; ignoriert."

msgid "Key %q in section [%s] is set again; the last value counts."
msgstr "Schlüssel %q im Abschnitt [%s] ist mehrfach gesetzt; der letzte Wert gilt."

# cmd/schnapp: Aufnahme (aufnehmen.go)
msgid "No area to repeat yet. Select one with --region first."
msgstr "Noch kein Bereich zum Wiederholen. Zuerst einen mit --region wählen."

msgid "The monitor of the last area has changed. Select a new area with --region."
msgstr "Der Monitor des letzten Bereichs hat sich geändert. Mit --region einen neuen Bereich wählen."

msgid "The selection is outside the captured image."
msgstr "Die Auswahl liegt außerhalb des aufgenommenen Bildes."

msgid "Could not save the screenshot: %v"
msgstr "Der Screenshot ließ sich nicht speichern: %v"

msgid "Could not write the path to standard output: %v"
msgstr "Der Pfad ließ sich nicht auf die Standardausgabe schreiben: %v"

msgid "Could not remember the area for --repeat: %v"
msgstr "Der Bereich für --repeat ließ sich nicht merken: %v"

# ui: Overlay
msgid "Click a monitor or drag an area · Enter: monitor under the pointer · Esc or right-click: cancel"
msgstr "Monitor anklicken oder Bereich aufziehen · Enter: Monitor unter dem Zeiger · Esc oder Rechtsklick: abbrechen"

msgid "Drag an area · Enter: whole monitor under the pointer · Esc or right-click: cancel"
msgstr "Bereich aufziehen · Enter: ganzer Monitor unter dem Zeiger · Esc oder Rechtsklick: abbrechen"

# settings/argumente: Härtung
msgid "%s: the settings file is not a regular file; using the defaults."
msgstr "%s: Die Einstellungsdatei ist keine reguläre Datei; es gelten die Voreinstellungen."

msgid "%s: the settings file is larger than 64 KiB; using the defaults."
msgstr "%s: Die Einstellungsdatei ist größer als 64 KiB; es gelten die Voreinstellungen."

msgid "… and %d more warning"
msgid_plural "… and %d more warnings"
msgstr[0] "… und %d weitere Warnung"
msgstr[1] "… und %d weitere Warnungen"

msgid "Option --screen cannot be given more than once with different monitor names."
msgstr "Die Option --screen lässt sich nicht mehrfach mit verschiedenen Monitornamen angeben."

# cmd/schnapp: ohne Zustandsordner (F-100)
msgid "No state directory (HOME is not set), so there is no last area to repeat."
msgstr "Kein Zustandsordner (HOME ist nicht gesetzt), darum gibt es keinen letzten Bereich zum Wiederholen."

msgid "Could not remember the area for --repeat: no state directory (HOME is not set)."
msgstr "Der Bereich für --repeat ließ sich nicht merken: kein Zustandsordner (HOME ist nicht gesetzt)."

# cmd/schnapp: automatisches Aufräumen (F-88, ADR-0016 Nachtrag 2)
msgid "Automatic cleanup of the library skipped: no state directory (HOME is not set)."
msgstr "Automatisches Aufräumen der Bibliothek ausgelassen: kein Zustandsordner (HOME ist nicht gesetzt)."

msgid "Automatic cleanup of the library skipped: %v"
msgstr "Automatisches Aufräumen der Bibliothek ausgelassen: %v"

msgid "Automatic cleanup of the library failed: %v"
msgstr "Automatisches Aufräumen der Bibliothek gescheitert: %v"

msgid "Automatic cleanup could not move %d screenshot to the trash."
msgid_plural "Automatic cleanup could not move %d screenshots to the trash."
msgstr[0] "Automatisches Aufräumen konnte %d Aufnahme nicht in den Papierkorb legen."
msgstr[1] "Automatisches Aufräumen konnte %d Aufnahmen nicht in den Papierkorb legen."

# cmd/schnapp: Editor öffnen (ADR-0020, ADR-0017 Nachtrag 4)
msgid "A file cannot be combined with %s."
msgstr "Eine Datei lässt sich nicht mit %s kombinieren."

msgid "Do not open the editor after capturing"
msgstr "Nach der Aufnahme keinen Editor öffnen"

msgid "Open FILE in the editor"
msgstr "DATEI im Editor öffnen"

# ui: Editor (#35, ADR-0020)
msgid "Could not save: %v"
msgstr "Speichern gescheitert: %v"

msgid "Copied to clipboard"
msgstr "In die Zwischenablage kopiert"

msgid "Copying is already in progress."
msgstr "Kopieren läuft schon."

msgid "Could not copy: finish the current action first."
msgstr "Kopieren nicht möglich: Erst die laufende Aktion beenden."

msgid "Saving…"
msgstr "Speichern …"

msgid "Copying…"
msgstr "Kopieren …"

msgid "Copied to clipboard as it was when copying began; later changes are not included."
msgstr "Kopiert mit dem Stand beim Kopieren; spätere Änderungen sind nicht enthalten."

msgid "Copying was not finished when the window closed; the clipboard may be empty."
msgstr "Kopieren war beim Schließen des Fensters nicht fertig; die Zwischenablage ist womöglich leer."

msgid "Saving does not respond. Closing the window now quits without waiting; changes may be lost."
msgstr "Speichern antwortet nicht. Schließen beendet jetzt ohne zu warten; Änderungen gehen womöglich verloren."

msgid "Saving did not respond; the changes may not have been saved."
msgstr "Speichern hat nicht geantwortet; die Änderungen sind womöglich nicht gesichert."

msgid "The clipboard holds the image only while this window is open. Close again to discard it."
msgstr "Die Zwischenablage hält das Bild nur, solange dieses Fenster offen ist. Erneutes Schließen verwirft es."

msgid "Could not save. Close again to discard the changes."
msgstr "Speichern gescheitert. Erneutes Schließen verwirft die Änderungen."

msgid "Export…"
msgstr "Exportieren …"

msgid "Export"
msgstr "Exportieren"

msgid "File dialog is open."
msgstr "Der Dateidialog ist geöffnet."

msgid "The file %s is damaged: writing failed and the old content could not be restored."
msgstr "Die Datei %s ist beschädigt: Das Schreiben ist gescheitert und der alte Inhalt ließ sich nicht wiederherstellen."

msgid "A file with this name already exists: %s"
msgstr "Eine Datei mit diesem Namen gibt es schon: %s"

msgid "Could not export: finish the current action first."
msgstr "Export nicht möglich: Erst die laufende Aktion beenden."

msgid "The connection to the desktop portal was lost."
msgstr "Die Verbindung zum Desktop-Portal ist abgebrochen."

msgid "The file dialog ended without a result."
msgstr "Der Dateidialog endete ohne Ergebnis."

msgid "The file dialog returned no file."
msgstr "Der Dateidialog nannte keine Datei."

msgid "PNG image"
msgstr "PNG-Bild"

msgid "JPEG image"
msgstr "JPEG-Bild"

msgid "SVG image"
msgstr "SVG-Bild"

msgid "Exported to %s"
msgstr "Exportiert nach %s"

msgid "Could not export: %v"
msgstr "Export nicht möglich: %v"

msgid "Could not export: only local files can be written."
msgstr "Export nicht möglich: Es lassen sich nur lokale Dateien schreiben."

msgid "No file dialog available (desktop portal missing)."
msgstr "Kein Dateidialog verfügbar (Desktop-Portal fehlt)."

msgid "Could not copy: %v"
msgstr "Kopieren gescheitert: %v"

msgid "Could not copy: no clipboard is available."
msgstr "Kopieren gescheitert: Keine Zwischenablage verfügbar."

msgid "Saved to the library"
msgstr "In der Bibliothek gespeichert"

msgid "Saved, but the old preview of this capture could not be removed."
msgstr "Gespeichert, aber die alte Vorschau dieser Aufnahme ließ sich nicht entfernen."

msgid "Saved, but the file has too many or too large annotations to be opened again. Remove some before closing."
msgstr "Gespeichert, aber die Datei hat zu viele oder zu große Beschriftungen, um sie wieder zu öffnen. Vor dem Schließen einige entfernen."

msgid "Saved as a new capture in the library: %s (the original file is unchanged)"
msgstr "Als neue Aufnahme in der Bibliothek gespeichert: %s (die ursprüngliche Datei bleibt unverändert)"

msgid "The previous file could not be updated; saved as a new capture: %s"
msgstr "Die bisherige Datei ließ sich nicht aktualisieren; als neue Aufnahme gespeichert: %s"

msgid "The old preview could not be removed."
msgstr "Die alte Vorschau ließ sich nicht entfernen."

# ui/cmd: Schließen, Konflikt, nichts zu speichern (F-107, F-109, F-110)
msgid "Could not save: %v. Close again to discard the changes."
msgstr "Speichern gescheitert: %v. Erneutes Schließen verwirft die Änderungen."

msgid "No changes to save."
msgstr "Keine Änderungen zu speichern."

msgid "The file was changed elsewhere since it was opened; saved as a new capture: %s"
msgstr "Die Datei wurde seit dem Öffnen anderswo geändert; als neue Aufnahme gespeichert: %s"

msgid "No permission to write the file."
msgstr "Keine Berechtigung, die Datei zu schreiben."

msgid "This file has too many or too large annotations to open. To open it anyway, use --ignore-limit."
msgstr "Die Datei hat zu viele oder zu große Beschriftungen, um sie zu öffnen. Mit --ignore-limit lässt sie sich trotzdem öffnen."

msgid "Option --ignore-limit works only together with a file."
msgstr "Die Option --ignore-limit gilt nur zusammen mit einer Datei."

msgid "Open FILE even if it is too costly to render"
msgstr "DATEI auch öffnen, wenn sie zu aufwendig zu rendern ist"

msgid "Not enough disk space."
msgstr "Nicht genug Speicherplatz."

msgid "The file could not be written."
msgstr "Die Datei ließ sich nicht schreiben."

msgid "Interrupted by a signal after %s was written completely."
msgstr "Durch ein Signal unterbrochen, nachdem %s vollständig geschrieben war."

msgid "Interrupted again while writing; the temporary file was removed."
msgstr "Beim Schreiben erneut unterbrochen; die temporäre Datei wurde entfernt."

msgid "Select"
msgstr "Auswählen"

msgid "Undo"
msgstr "Rückgängig"

msgid "Redo"
msgstr "Wiederholen"

msgid "Fit"
msgstr "Einpassen"

msgid "Save"
msgstr "Speichern"

# ui/editor.go: Zeichenwerkzeuge (ADR-0021)
msgid "Arrow"
msgstr "Pfeil"

msgid "Rectangle"
msgstr "Rechteck"

msgid "Text"
msgstr "Text"

msgid "Step"
msgstr "Nummer"

msgid "Color"
msgstr "Farbe"

msgid "Type the text. Enter: done, Shift+Enter: new line, Esc: discard."
msgstr "Text eingeben. Enter: fertig, Umschalt+Enter: neue Zeile, Esc: verwerfen."

msgid "Drag to draw an arrow. Shift: 45° steps. Drag the middle handle to bend it."
msgstr "Ziehen zeichnet einen Pfeil. Umschalt: 45°-Schritte. Am mittleren Griff ziehen biegt ihn."

msgid "Drag to draw a rectangle. Shift: square."
msgstr "Ziehen zeichnet ein Rechteck. Umschalt: Quadrat."

msgid "Click to place text, or click a text to edit it."
msgstr "Klick setzt einen Text, Klick auf einen Text bearbeitet ihn."

msgid "Click to place step number %d."
msgstr "Klick setzt die Schritt-Nummer %d."

msgid "The limit of %d annotations is reached. Delete some to add more."
msgstr "Die Grenze von %d Beschriftungen ist erreicht. Zum Hinzufügen erst einige löschen."

msgid "Step numbers end at %d; no further number can be placed."
msgstr "Die Schritt-Nummern enden bei %d; eine weitere Nummer lässt sich nicht setzen."

msgid "The editor could not be opened or saved: %v"
msgstr "Der Editor ließ sich nicht öffnen oder nicht speichern: %v"

# cmd/schnapp: Fehler beim Öffnen (Kritik A-9)
msgid "Cannot open %s: %s"
msgstr "%s lässt sich nicht öffnen: %s"

msgid "The file does not exist."
msgstr "Die Datei gibt es nicht."

msgid "No permission to read the file."
msgstr "Keine Berechtigung, die Datei zu lesen."

msgid "This is not a regular file."
msgstr "Das ist keine gewöhnliche Datei."

msgid "This is neither a PNG nor a JPEG image."
msgstr "Das ist weder ein PNG- noch ein JPEG-Bild."

msgid "The image is too large."
msgstr "Das Bild ist zu groß."

msgid "The image is damaged."
msgstr "Das Bild ist beschädigt."

msgid "The selection overlay did not close in time."
msgstr "Das Auswahl-Overlay hat sich nicht rechtzeitig geschlossen."

msgid "No home directory (HOME is not set)."
msgstr "Kein Heimverzeichnis (HOME ist nicht gesetzt)."

msgid "Redact"
msgstr "Schwärzen"

msgid "Pixelate"
msgstr "Verpixeln"

msgid "Too narrow to pixelate; the area was blacked out instead."
msgstr "Zu schmal zum Verpixeln; der Bereich wurde stattdessen geschwärzt."

msgid "Drag over the area to black out. The pixels are overwritten for good once saved."
msgstr "Über den Bereich ziehen, der geschwärzt werden soll. Nach dem Speichern sind die Pixel endgültig überschrieben."

msgid "Drag over the area to pixelate. The pixels are overwritten for good once saved."
msgstr "Über den Bereich ziehen, der verpixelt werden soll. Nach dem Speichern sind die Pixel endgültig überschrieben."

msgid "The previous file could not be updated and still showed the unredacted content, so it was removed. Saved as a new capture: %s"
msgstr "Die bisherige Datei ließ sich nicht aktualisieren und zeigte noch den ungeschwärzten Inhalt; sie wurde entfernt. Als neue Aufnahme gespeichert: %s"

msgid "The previous file could not be updated and still shows the unredacted content: %s. Delete it yourself. Saved as a new capture: %s"
msgstr "Die bisherige Datei ließ sich nicht aktualisieren und zeigt noch den ungeschwärzten Inhalt: %s. Bitte selbst löschen. Als neue Aufnahme gespeichert: %s"

msgid "Saved as a new capture in the library: %s. The original file is unchanged and still shows the unredacted content."
msgstr "Als neue Aufnahme in der Bibliothek gespeichert: %s. Die ursprüngliche Datei ist unverändert und zeigt noch den ungeschwärzten Inhalt."

msgid "The other version may still show the unredacted content."
msgstr "Die andere Fassung zeigt womöglich noch den ungeschwärzten Inhalt."

msgid "Saved, but a leftover temporary copy of this capture could not be removed and may still show the unredacted content."
msgstr "Gespeichert, aber eine liegen gebliebene temporäre Kopie dieser Aufnahme ließ sich nicht entfernen und zeigt womöglich noch den ungeschwärzten Inhalt."

msgid "Saved, but a leftover temporary copy of this capture could not be removed."
msgstr "Gespeichert, aber eine liegen gebliebene temporäre Kopie dieser Aufnahme ließ sich nicht entfernen."

msgid "Also, a leftover temporary copy of this capture could not be removed and may still show the unredacted content."
msgstr "Außerdem ließ sich eine liegen gebliebene temporäre Kopie dieser Aufnahme nicht entfernen; sie zeigt womöglich noch den ungeschwärzten Inhalt."

msgid "Also, a leftover temporary copy of this capture could not be removed."
msgstr "Außerdem ließ sich eine liegen gebliebene temporäre Kopie dieser Aufnahme nicht entfernen."

msgid "A temporary copy of the previous file could not be removed and may still show the unredacted content."
msgstr "Eine temporäre Kopie der bisherigen Datei ließ sich nicht entfernen und zeigt womöglich noch den ungeschwärzten Inhalt."

msgid "A temporary copy of the earlier file %s could not be removed and may still show the unredacted content."
msgstr "Eine temporäre Kopie der früheren Datei %s ließ sich nicht entfernen und zeigt womöglich noch den ungeschwärzten Inhalt."

msgid "A temporary copy of the new capture could not be removed."
msgstr "Eine temporäre Kopie der neuen Aufnahme ließ sich nicht entfernen."

msgid "Warning: a temporary copy of the screenshot could not be removed and may still show it after you redact it later."
msgstr "Warnung: Eine temporäre Kopie der Aufnahme ließ sich nicht entfernen und zeigt sie womöglich nach einer späteren Schwärzung noch."

msgid "Saved, but the old preview of this capture could not be removed and still shows the unredacted content."
msgstr "Gespeichert, aber das alte Vorschaubild dieser Aufnahme ließ sich nicht entfernen und zeigt noch den ungeschwärzten Inhalt."

msgid "The previous file could not be updated and was removed, but its preview could not be removed and still shows the unredacted content. Saved as a new capture: %s"
msgstr "Die bisherige Datei ließ sich nicht aktualisieren und wurde entfernt, ihr Vorschaubild aber nicht; es zeigt noch den ungeschwärzten Inhalt. Als neue Aufnahme gespeichert: %s"

msgid "The previous file %s was no longer there; wherever it is now, it still shows the unredacted content. Saved as a new capture: %s"
msgstr "Die bisherige Datei %s war nicht mehr da; wo immer sie jetzt liegt, zeigt sie noch den ungeschwärzten Inhalt. Als neue Aufnahme gespeichert: %s"

msgid "The previous file %s was no longer there; wherever it is now, it still shows the unredacted content. Its preview could not be removed and still shows it too. Saved as a new capture: %s"
msgstr "Die bisherige Datei %s war nicht mehr da; wo immer sie jetzt liegt, zeigt sie noch den ungeschwärzten Inhalt. Ihr Vorschaubild ließ sich nicht entfernen und zeigt ihn ebenfalls. Als neue Aufnahme gespeichert: %s"

msgid "It still shows the unredacted content."
msgstr "Es zeigt noch den ungeschwärzten Inhalt."

# ui: Zuschneiden und Stauchen (ADR-0023)
msgid "Crop"
msgstr "Zuschneiden"

msgid "Cut out"
msgstr "Stauchen"

msgid "Drag the edges or corners inwards, or drag a new frame. Double-click: whole image again. Cropped parts stay in the working file; redact what must go."
msgstr "Kanten oder Ecken nach innen ziehen oder einen neuen Rahmen ziehen. Doppelklick: wieder das ganze Bild. Weggeschnittenes bleibt in der Arbeitsdatei; Heikles schwärzen."

msgid "Drag across the part to cut out: vertically for rows, horizontally for columns. Double-click a seam to restore it. Cut-out parts stay in the working file; redact what must go."
msgstr "Über den Teil ziehen, der wegfallen soll: senkrecht für Zeilen, waagrecht für Spalten. Doppelklick auf eine Naht holt ihn zurück. Herausgenommenes bleibt in der Arbeitsdatei; Heikles schwärzen."

msgid "%d annotation is now hidden outside the visible area; it returns when the crop or cut is removed."
msgid_plural "%d annotations are now hidden outside the visible area; they return when the crop or cut is removed."
msgstr[0] "%d Beschriftung liegt jetzt verborgen außerhalb des sichtbaren Bereichs; sie kehrt zurück, wenn Zuschnitt oder Stauchung entfallen."
msgstr[1] "%d Beschriftungen liegen jetzt verborgen außerhalb des sichtbaren Bereichs; sie kehren zurück, wenn Zuschnitt oder Stauchung entfallen."

msgid "Nothing of the image would remain; cut out a smaller part."
msgstr "Vom Bild bliebe nichts übrig; einen kleineren Teil herausnehmen."

msgid "Too many cuts; undo or remove one first."
msgstr "Zu viele Stauch-Streifen; erst einen entfernen oder rückgängig machen."

msgid "The original file %s is unchanged and still shows the unredacted content."
msgstr "Die ursprüngliche Datei %s ist unverändert und zeigt noch den ungeschwärzten Inhalt."

msgid "The other version %s may still show the unredacted content."
msgstr "Die andere Fassung %s zeigt womöglich noch den ungeschwärzten Inhalt."

msgid "The earlier file %s, left behind when saving failed, was removed, but its preview could not be removed and still shows the unredacted content."
msgstr "Die frühere Datei %s, die bei einem gescheiterten Speichern liegen blieb, wurde entfernt, ihr Vorschaubild aber nicht; es zeigt noch den ungeschwärzten Inhalt."

msgid "The earlier file %s, left behind when saving failed, still showed the unredacted content and was removed."
msgstr "Die frühere Datei %s, die bei einem gescheiterten Speichern liegen blieb, zeigte noch den ungeschwärzten Inhalt und wurde entfernt."

msgid "The earlier file %s was no longer there; wherever it is now, it still shows the unredacted content. Its preview could not be removed and still shows it too."
msgstr "Die frühere Datei %s war nicht mehr da; wo immer sie jetzt liegt, zeigt sie noch den ungeschwärzten Inhalt. Ihr Vorschaubild ließ sich nicht entfernen und zeigt ihn ebenfalls."

msgid "The earlier file %s was no longer there; wherever it is now, it still shows the unredacted content."
msgstr "Die frühere Datei %s war nicht mehr da; wo immer sie jetzt liegt, zeigt sie noch den ungeschwärzten Inhalt."

msgid "The earlier file %s still shows the unredacted content. Delete it yourself."
msgstr "Die frühere Datei %s zeigt noch den ungeschwärzten Inhalt. Bitte selbst löschen."

msgid "Whole image"
msgstr "Ganzes Bild"

msgid "The part reached the edge and was cropped off; “Whole image” brings it back."
msgstr "Der Teil reichte bis an den Rand und wurde abgeschnitten; „Ganzes Bild“ holt ihn zurück."

msgid "The area is too small to redact at this zoom; zoom in or draw a larger area."
msgstr "Der Bereich ist bei diesem Zoom zu klein zum Schwärzen; hineinzoomen oder einen größeren Bereich ziehen."

msgid "Menu"
msgstr "Menü"

msgid "Copy"
msgstr "Kopieren"

msgid "Delete"
msgstr "Löschen"

msgid "Edit text"
msgstr "Text bearbeiten"

msgid "Restore cut-out areas"
msgstr "Gestauchtes zurückholen"

msgid "Seam style"
msgstr "Kantenform"

msgid "Seam style: torn edge"
msgstr "Kantenform: Abriss"

msgid "Seam style: wave"
msgstr "Kantenform: Welle"

msgid "Seam style: zigzag"
msgstr "Kantenform: Zacken"

msgid "Close"
msgstr "Schließen"

msgid "Ctrl"
msgstr "Strg"

msgid "Shift"
msgstr "Umschalt"

msgid "Del"
msgstr "Entf"

msgid "Backspace"
msgstr "Rücktaste"

msgid "Enter"
msgstr "Eingabe"

msgid "Restored unsaved changes from %s. Undo returns to the saved state."
msgstr "Ungesicherte Änderungen vom %s wiederhergestellt. Rückgängig führt zum gespeicherten Stand."

msgid "A rescue copy for this file could not be read. It is kept for 30 days in the state folder: %s"
msgstr "Eine Rettungskopie zu dieser Datei war nicht lesbar. Sie bleibt 30 Tage im Zustandsordner erhalten: %s"

msgid "Unsaved changes from %s were not restored: the file has changed since. The rescue copy is kept for 30 days in the state folder: %s"
msgstr "Ungesicherte Änderungen vom %s nicht wiederhergestellt: Die Datei wurde seitdem geändert. Die Rettungskopie bleibt 30 Tage im Zustandsordner erhalten: %s"

msgid "Unsaved changes from %s could not be restored. The rescue copy is kept for 30 days in the state folder: %s"
msgstr "Ungesicherte Änderungen vom %s ließen sich nicht wiederherstellen. Die Rettungskopie bleibt 30 Tage im Zustandsordner erhalten: %s"

msgid "This file is open in another Schnapp window. Changes made here are not protected by a rescue copy."
msgstr "Diese Datei ist in einem anderen Schnapp-Fenster geöffnet. Änderungen in diesem Fenster sichert keine Rettungskopie."

# cmd/schnapp: Schnittstelle für Skripte und Agenten (agenten.go, ADR-0030)
msgid "Option %s needs a file name after an equals sign: %s=FILE."
msgstr "Die Option %s braucht einen Dateinamen nach einem Gleichheitszeichen: %s=DATEI."

msgid "Option %s cannot be given more than once with different files."
msgstr "Die Option %s darf nicht mehrfach mit verschiedenen Dateien angegeben werden."

msgid "Unknown file type for %s: use a name ending in .png, .jpg or .svg."
msgstr "Unbekannter Dateityp für %s: Der Name muss auf .png, .jpg oder .svg enden."

msgid "Option --export needs the file to export: --export=TARGET FILE."
msgstr "Die Option --export braucht die zu exportierende Datei: --export=ZIEL DATEI."

msgid "Write the screenshot to FILE (.png, .jpg, .svg) instead of the library"
msgstr "Aufnahme nach DATEI schreiben (.png, .jpg, .svg) statt in die Bibliothek"

msgid "Print the result as one line of JSON"
msgstr "Ergebnis als eine Zeile JSON ausgeben"

msgid "Export FILE to TARGET (.png, .jpg, .svg) without a window"
msgstr "DATEI ohne Fenster nach ZIEL exportieren (.png, .jpg, .svg)"

msgid "Could not write to standard output: %v"
msgstr "Konnte nicht auf die Standardausgabe schreiben: %v"

msgid "No permission to write there."
msgstr "Keine Berechtigung, dort zu schreiben."

msgid "The folder does not exist."
msgstr "Den Ordner gibt es nicht."

msgid "Could not write %s: %s"
msgstr "Konnte %s nicht schreiben: %s"

msgid "Option --export needs a target file after an equals sign: --export=TARGET FILE."
msgstr "Die Option --export braucht eine Zieldatei nach einem Gleichheitszeichen: --export=ZIEL DATEI."

msgid "Cannot export %s onto itself; choose a different target."
msgstr "%s lässt sich nicht auf sich selbst exportieren; bitte ein anderes Ziel wählen."

msgid "With --json, the file name for %s must be valid UTF-8."
msgstr "Mit --json muss der Dateiname für %s gültiges UTF-8 sein."

msgid "The path is not valid UTF-8 and cannot be written as JSON."
msgstr "Der Pfad ist kein gültiges UTF-8 und lässt sich nicht als JSON ausgeben."

msgid "Writing failed and the old content could not be restored; the target file is incomplete."
msgstr "Das Schreiben ist gescheitert und der alte Inhalt ließ sich nicht wiederherstellen; die Zieldatei ist unvollständig."

# Formate je Sprache (ADR-0014 Nachtrag 2): „date format“ ist ein Go-Zeitmuster (Referenzzeit 2006-01-02 15:04),
# „status bar“ die Größen- und Zoomangabe rechts in der Statusleiste.
msgctxt "date format"
msgid "2006-01-02 15:04"
msgstr "02.01.2006 15:04"

msgctxt "status bar"
msgid "%d × %d · %d%%"
msgstr "%d × %d · %d %%"
