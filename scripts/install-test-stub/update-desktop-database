# Attrappe für update-desktop-database im Test von install.sh (scripts/install-test.sh, F-367): baut und ändert nichts,
# hängt „update-desktop-database <argumente>“ an $STUB_LOG an und endet mit 0. Das echte Werkzeug aus /usr/bin
# bleibt außen vor, weil dieser Ordner im PATH des Tests vorn steht.
set -eu
[ -n "${STUB_LOG:-}" ] || { echo "update-desktop-database-Attrappe: STUB_LOG fehlt" >&2; exit 1; }
printf '%s\n' "update-desktop-database $*" >> "$STUB_LOG"
exit 0
