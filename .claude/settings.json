{
  "permissions": {
    "allow": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(git*push*--force*)",
      "Bash(git*push*-f*)",
      "Bash(git*push* +*)",
      "Bash(git*push*--delete*)",
      "Bash(git*push* :*)",
      "Bash(git*push*--all*)",
      "Bash(git*push*--mirror*)",
      "Bash(git*push*--tags*)",
      "Bash(git*push*alt-main*)",
      "Bash(git*push*refs/*)"
    ]
  }
}
