+//export gio_onOutputName
+func gio_onOutputName(data unsafe.Pointer, output *C.struct_wl_output, name *C.char) {
+	d := callbackLoad(data).(*wlDisplay)
+	d.outputConfig[output].name = C.GoString(name)
+}
+
+// outputByName returns the output with the given name, or nil.
+func (d *wlDisplay) outputByName(name string) *C.struct_wl_output {
+	if name == "" {
+		return nil
+	}
+	for o, c := range d.outputConfig {
+		if c.name == name {
+			return o
+		}
+	}
+	return nil
+}
+
+// WaylandOutput describes a Wayland output as announced by wl_output.
+type WaylandOutput struct {
+	Name          string
+	Width, Height int // current mode in physical pixels
+	Scale         int // integer buffer scale
+}
+
+// WaylandOutputs connects to the Wayland display and lists its outputs.
+func WaylandOutputs() ([]WaylandOutput, error) {
+	d, err := newWLDisplay()
+	if err != nil {
+		return nil, err
+	}
+	defer d.destroy()
+	var out []WaylandOutput
+	for _, c := range d.outputConfig {
+		out = append(out, WaylandOutput{Name: c.name, Width: c.width, Height: c.height, Scale: c.scale})
+	}
+	return out, nil
+}
